{
  "id": "stepbot",
  "name": "StepBot",
  "meta": { "vendor": "Espressif", "mcu": "esp32c3" },
  "icon": { "preset": "espbot", "faIcon": "fa-robot", "imageRef": "stepbot.png" },

  "connection": {
    "baud": 115200,
    "replMode": "raw-paste",
    "resetOnConnect": false,
    "eol": "\r\n"
  },

  "runtime": {
    "dialect": "machine",
    "imports": ["from machine import Pin"]
  },

  "pins": {
    "digital": [0, 1, 3, 4, 5, 6, 7, 8, 9, 20, 21],
    "analog": [0, 1, 3, 4, 5],
    "pwm": [0, 1, 3, 4, 5, 6, 7, 8, 9, 20, 21],
    "dac": [],
    "touch": [],
    "aliases": {}
  },

  "buses": {
    "i2c": [{ "id": 0, "scl": 9, "sda": 8, "freq": 400000 }],
    "spi": [{ "id": 1, "sck": 4, "mosi": 6, "miso": 5 }],
    "uart": [{ "id": 1, "tx": 21, "rx": 20 }]
  },

  "constraints": {
    "adcBits": 12,
    "adcVref": 3.3,
    "pwmFreqHz": [1, 40000000],
    "logicVoltage": 3.3
  },

  "onboard": [{ "type": "neopixel", "pin": 10, "name": "RGB LED (IO10)" }],

  "capabilities": ["gpio", "adc", "pwm", "i2c", "spi", "uart", "wifi", "ble", "espnow", "neopixel"],

  "pluginsExclude": ["core-stepper"],

  "libraries": [],
  "examples": [],

  "presets": {
    "Bluetooth": [
      {
        "kind": "block",
        "type": "ble_begin",
        "inputs": { "NAME": { "shadow": { "type": "text_literal", "fields": { "TEXT": "StepBot" } } } },
        "next": {
          "block": {
            "type": "forever",
            "inputs": {
              "DO": {
                "block": {
                  "type": "if_else",
                  "inputs": {
                    "COND": { "block": { "type": "ble_button", "fields": { "BTN": "ButtonUp", "STATE": "True" } } },
                    "DO": {
                      "block": {
                        "type": "stepbot_drive",
                        "fields": { "DIR": "forward" },
                        "inputs": { "SPEED": { "shadow": { "type": "math_number", "fields": { "NUM": 100 } } } }
                      }
                    },
                    "ELSE": {
                      "block": { "type": "stepbot_stop", "fields": { "MOTOR": "StepBot.MotorLeftAndRight", "HOW": "stop" } }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },

  "overrides": {}
}
